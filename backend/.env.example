# Numbered keys (preferred)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Optional Groq text fallback — https://console.groq.com/keys
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# Live voice model
GEMINI_LIVE_MODEL=gemini-3.8-live

# Text interviewer model via LiteLLM
GEMINI_TEXT_MODEL=gemini/gemini-3.8-flash
GROQ_TEXT_MODEL=groq/qwen/qwen3.8-27b

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
